{
    "name": "@diia-inhouse/i18n",
    "version": "3.9.2",
    "description": "Internationalization package",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-i18n",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@diia-inhouse/diia-logger": "4.7.66",
        "@diia-inhouse/diia-metrics": "7.1.197",
        "glob": "14.0.2",
        "i18next": "26.3.4",
        "i18next-fs-backend": "2.6.6"
    },
    "devDependencies": {
        "@commitlint/cli": "20.4.2",
        "@diia-inhouse/configs": "7.4.0",
        "@diia-inhouse/errors": "2.3.50",
        "@diia-inhouse/oxc-config": "6.2.1",
        "@diia-inhouse/test": "8.4.16",
        "@diia-inhouse/types": "14.13.3",
        "@diia-inhouse/validators": "2.3.1",
        "@types/node": "25.6.2",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "lockfile-lint": "5.0.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "tsdown": "0.22.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.11",
        "vitest-mock-extended": "4.0.0"
    },
    "peerDependencies": {
        "@diia-inhouse/types": ">=14.9.0",
        "@diia-inhouse/validators": ">=2.0.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "branches": [
            "main"
        ],
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
